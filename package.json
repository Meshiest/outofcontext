{
  "name": "ooc",
  "version": "2.1.1",
  "description": "Out of Context Games",
  "type": "module",
  "main": "main.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "cd client && npm run build",
    "start": "tsx --tsconfig server/tsconfig.json main.ts",
    "start:prod": "cross-env NODE_ENV=production tsx --tsconfig server/tsconfig.json main.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:client": "cd client && tsc -p tsconfig.app.json --noEmit",
    "lint:client": "cd client && npm run lint",
    "dev": "concurrently -n backend,client -c blue,green \"tsx watch --tsconfig server/tsconfig.json main.ts\" \"cd client && npm run dev\"",
    "dev:host": "concurrently -n backend,client -c blue,green \"tsx watch --tsconfig server/tsconfig.json main.ts\" \"cd client && npm run dev -- --host\"",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json main.ts",
    "dev:client": "cd client && npm run dev",
    "dev:storybook": "cd client && npm run storybook",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism",
    "test:client": "vitest run --project client --no-file-parallelism",
    "test:backend": "vitest run --project backend --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "author": "Isaac Hirschfeld",
  "license": "ISC",
  "dependencies": {
    "@trpc/server": "^11.18.0",
    "@types/compression": "^1.8.1",
    "body-parser": "^1.18.3",
    "compression": "^1.8.1",
    "express": "^4.16.4",
    "glob": "^7.1.6",
    "lodash": "^4.17.19",
    "node-cron": "^2.0.3",
    "pako": "^1.0.10",
    "prom-client": "^15.1.3",
    "tsx": "^4.23.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^4.17.25",
    "@types/glob": "^8.1.0",
    "@types/lodash": "^4.17.25",
    "@types/node-cron": "^3.0.11",
    "@types/pako": "^1.0.7",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^4",
    "concurrently": "^9",
    "cross-env": "^7",
    "jsdom": "^28",
    "typescript": "^5.9.3",
    "vitest": "^4"
  }
}
