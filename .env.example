# Out Of Context - environment configuration example.
# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.
# docker-compose auto-reads `.env` in this directory for variable interpolation.

# ---- Server (runtime) -----------------------------------------------------------------------
# Port the Express server listens on. Default 8080 (see main.ts). The compose port mapping and
# the healthcheck both follow this value.
PORT=8080

# Node environment. Use `production` for real deployments; enables production behavior/logging.
NODE_ENV=production

# ---- Metrics (OPTIONAL - off unless METRICS_PORT is set) ------------------------------------
# Prometheus metrics are served from their OWN listener, not the app port, because a scrape exposes
# far more operational detail than anything else the app serves. Unset = no listener at all.
# METRICS_PORT=9090
# Bind address for that listener. Defaults to 127.0.0.1, so it stays private even if the port is
# opened by accident. Set 0.0.0.0 only when you deliberately want to scrape from off-box.
# METRICS_HOST=127.0.0.1

# Bearer token for GET /metrics on the MAIN app port - the route to use when something off-box
# scrapes you, since nginx and Cloudflare already front this port. Unset means the route is never
# registered at all; an unset secret must never degrade into an open endpoint. Minimum 16
# characters, and a shorter one is refused rather than quietly accepted.
#   Scrape with: Authorization: Bearer <token>   (Prometheus: `bearer_token` in scrape_config)
#   Generate one: openssl rand -hex 32
# METRICS_TOKEN=

# ---- Horizontal scale - OPTIONAL, unused while a single instance runs the app ---------------
# Redis connection string for the lobby->instance registry, cross-instance stat aggregation, and
# failover. Uncomment and point at your Redis when enabling multi-instance.
# REDIS_URL=redis://localhost:6379
